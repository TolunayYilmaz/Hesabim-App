# Supabase (backend .env ile ayni proje bilgileri)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# FastAPI backend adresi. Local gelistiricide zorunlu degil (varsayilan
# http://localhost:8000/api). Uretimde bos birakilir; /api istekleri
# frontend/vercel.json rewrite'i ile backend'e yonlendirilir.
NEXT_PUBLIC_API_URL=http://localhost:8000/api