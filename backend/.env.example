# Supabase proje URL ve key'leri (Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Service role anahtari YALNIZCA backend tarafindadir (frontend'e acmayin).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://xxxxxxxx.supabase.co/auth/v1/.well-known/jwks.json

# Eski usul HS256 dogrulama istenirse (JWKS yerine):
# SUPABASE_JWT_SECRET=your-super-secret-jwt-secret

# CORS (virgulle ayrilmis)
CORS_ORIGINS=http://localhost:3000,https://<frontend-domain>.vercel.app
DEBUG=false